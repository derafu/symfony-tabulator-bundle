{
    "name": "derafu/symfony-tabulator-bundle",
    "description": "Derafu: Symfony Tabulator Bundle - Integrates Tabulator with API Platform.",
    "type": "symfony-bundle",
    "homepage": "https://www.derafu.dev/docs/symfony/tabulator-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Esteban De La Fuente Rubio / Derafu",
            "homepage": "https://www.derafu.dev"
        }
    ],
    "support": {
        "issues": "https://github.com/derafu/symfony-tabulator-bundle/issues",
        "source": "https://github.com/derafu/symfony-tabulator-bundle"
    },
    "autoload": {
        "psr-4": {
            "Derafu\\TabulatorBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Derafu\\TestsTabulatorBundle\\": "tests/src/"
        }
    },
    "require": {
        "php": "^8.5",
        "api-platform/core": "^4.4",
        "derafu/array": "dev-main",
        "derafu/translation": "dev-main",
        "derafu/value": "dev-main",
        "symfony/config": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/event-dispatcher": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/http-kernel": "^8.1",
        "symfony/serializer": "^8.1",
        "symfony/yaml": "^8.1"
    },
    "require-dev": {
        "derafu/symfony-query-bundle": "dev-main",
        "doctrine/doctrine-bundle": "^3.4",
        "doctrine/orm": "^3.7",
        "ext-pdo_sqlite": "*",
        "ext-xdebug": "*",
        "friendsofphp/php-cs-fixer": "^3.95",
        "nikic/php-parser": "^5.9",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.4"
    },
    "scripts": {
        "tests": "XDEBUG_MODE=coverage vendor/bin/phpunit --configuration=phpunit.xml",
        "phpcs-fix": "vendor/bin/php-cs-fixer fix -v --config=php-cs-fixer.php",
        "phpcs": "vendor/bin/php-cs-fixer fix -v --dry-run --diff --config=php-cs-fixer.php",
        "phpstan": "vendor/bin/phpstan analyse --configuration=phpstan.neon --memory-limit=1G"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
